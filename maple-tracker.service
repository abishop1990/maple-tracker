[Unit]
Description=Maple Water Tracker
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/maple-tracker
ExecStart=/home/YOUR_USERNAME/maple-tracker/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 "web.app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target